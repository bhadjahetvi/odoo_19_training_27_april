<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_delivery_report_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.delivery.report.wizard.form</field>
        <field name="model">sale.delivery.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Delivery Report">
                <group>
                    <field name="report_type"/>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Print Report"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_delivery_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Sales Delivery Report</field>
        <field name="res_model">sale.delivery.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>