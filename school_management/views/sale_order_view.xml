<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_inherit_advance_payment"
            model="ir.ui.view">

        <field name="name">
            sale.order.form.inherit.advance.payment
        </field>

        <field name="model">sale.order</field>

        <field name="inherit_id"
               ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <!-- =========================
                 Advance Payment Button
                 ========================= -->

            <xpath expr="//header"
                   position="inside">

                <button name="action_open_advance_payment_wizard"
                        string="Advance Payment"
                        type="object"
                        class="btn-primary"/>

            </xpath>

            <!-- =========================
                 Smart Button
                 ========================= -->

            <xpath expr="//div[@name='button_box']"
                   position="inside">

                <button name="action_view_advance_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">

                    <field name="advance_payment_count"
                           string="Advance Payments"
                           widget="statinfo"/>

                </button>

            </xpath>

            <!-- =========================
                 Advance Payment Tab
                 ========================= -->

            <xpath expr="//notebook"
                   position="inside">

                <page string="Advance Payment Details">

                    <group col="2">

                        <field name="total_advance_amount"
                               readonly="1"/>

                        <field name="remaining_amount"
                               readonly="1"/>

                        <field name="advance_payment_count"
                               readonly="1"/>

                    </group>

                    <field name="advance_payment_ids"
                           readonly="1">

                        <list string="Advance Payments">

                            <field name="name"/>

                            <field name="partner_id"/>

                            <field name="amount"/>

                            <field name="date"/>

                            <field name="state"/>

                        </list>

                    </field>

                </page>

            </xpath>

        </field>

    </record>

</odoo>