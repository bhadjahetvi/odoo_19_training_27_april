<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_move_form_inherit_advance_payment"
            model="ir.ui.view">

        <field name="name">
            account.move.form.inherit.advance.payment
        </field>

        <field name="model">account.move</field>

        <field name="inherit_id"
               ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook"
                   position="inside">

                <page string="Advance Payments">

                    <group>

                        <field name="advance_amount"
                               readonly="1"/>

                        <field name="remaining_amount"
                               readonly="1"/>

                    </group>

                    <field name="advance_payment_ids"
                           readonly="1">

                        <list>

                            <field name="name"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="state"/>

                        </list>

                    </field>

                </page>

            </xpath>

        </field>

    </record>

</odoo>