<odoo>

    <!-- FORM VIEW-->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">

            <form>
                <header>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-success"
                            invisible="status != 'confirm'"/>

                    <button name="action_pay"
                            string="Pay"
                            type="object"
                            class="btn-warning"
                            invisible="status != 'confirm'"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,confirm,done"/>

                </header>

                <sheet>

                    <!--HEADER -->
                    <div class="d-flex flex-column flex-sm-row align-items-center">

                        <!-- IMAGE -->
                        <div class="ms-2 p-0">
                            <field name="image"
                                   widget="image"
                                   class="m-0"
                                   options="{'size': [128,128]}"/>
                        </div>

                        <!-- DETAILS -->
                        <div class="col-12 col-sm-6 col-md-7 col-lg-8 px-4">

                            <div class="oe_title mw-100">

                                <!-- NAME -->
                                <h1>
                                    <field name="name"
                                           placeholder="Student Name"
                                           required="1"
                                           style="font-size: 2.5rem;"/>
                                </h1>

                                <!-- EMAIL -->
                                <h5 class="d-flex align-items-center mb-1">
                                    <i class="fa fa-envelope me-2 text-primary" title="Email"/>
                                    <field name="email" widget="email"/>
                                </h5>

                                <!-- PHONE -->
                                <h5 class="d-flex align-items-center mb-1">
                                    <i class="fa fa-phone me-2 text-primary" title="Phone"/>
                                    <field name="phone" widget="phone"/>
                                </h5>

                                <!-- GENDER -->
                                <h5 class="d-flex align-items-center mb-1">
                                    <i class="fa fa-user me-2 text-primary" title="Gender"/>
                                    <field name="gender"/>
                                </h5>

                            </div>
                        </div>

                    </div>

                    <group col="2">

                        <!-- LEFT -->
                        <group string="Other Details">
                            <field name="age"/>
                            <field name="dob"/>
                            <field name="admission_datetime"/>
                        </group>

                        <!-- RIGHT -->
                            <group string="School Details">
                                <field name="subject_ids" widget="many2many_tags"/>
                                <field name="teacher_id" widget="many2many_tags"/>
                                <field name="currency_id"/>
                                <field name="fees" widget="monetary" readonly="1"/>
                            </group>
                    </group>
                    <!-- NOTES -->
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>

                </sheet>

                <!-- CHATTER -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>

            </form>

        </field>
    </record>


    <!-- ================= LIST VIEW ================= -->
    <record id="view_student_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="fees"/>
                <field name="status"/>
            </list>

        </field>
    </record>


    <!-- ================= KANBAN VIEW ================= -->
    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">

            <kanban>
                <field name="name"/>
                <field name="image"/>
                <field name="fees"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_card">

                            <div>
                                <img t-att-src="'/web/image/school.student/' + record.id.raw_value + '/image'"
                                     style="width:100px;height:100px;"
                                     alt="Student Image"/>
                            </div>

                            <div>
                                <strong><field name="name"/></strong>
                                <div>Fees: <field name="fees"/></div>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>

        </field>
    </record>


    <!-- ================= ACTION ================= -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form,kanban</field>
    </record>


    <!-- ================= MENU ================= -->
    <menuitem id="menu_school_root" name="School"/>
    <menuitem id="menu_student"
              name="Students"
              parent="menu_school_root"
              action="action_student"
              sequence="1"/>

</odoo>