<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">subject.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">

            <form string="Subject">
                <sheet>
                    <group>
                        <field name="name" placeholder="Enter Subject Name"/>
                        <field name="teacher_id"/>
                        <field name="fee"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>


    <!-- ================= LIST VIEW ================= -->
    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">subject.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="fee"/>
                <field name="currency_id"/>
            </list>

        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ================= MENU ================= -->
    <menuitem id="menu_subject"
              name="Subjects"
              parent="menu_school_root"
              action="action_subject"
              sequence="3"/>

</odoo>