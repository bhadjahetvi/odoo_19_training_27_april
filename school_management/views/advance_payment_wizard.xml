<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_advance_payment_wizard_form" model="ir.ui.view">

        <field name="name">advance.payment.wizard.form</field>

        <field name="model">advance.payment.wizard</field>

        <field name="arch" type="xml">

            <form string="Advance Payment">

                <group>

                    <field name="payment_type"/>

                    <field name="amount"
                           invisible="payment_type != 'fixed'"/>

                    <field name="percentage"
                           invisible="payment_type != 'percentage'"/>

                    <field name="final_amount" readonly="1"/>

                </group>

                <footer>

                    <button name="action_create_payment"
                            string="Create Payment"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>