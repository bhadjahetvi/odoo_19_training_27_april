<odoo>

    <!-- FORM VIEW  -->
    <record id="view_teacher_form" model="ir.ui.view">
        <field name="name">teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">

            <form>
                <header>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-success"
                            invisible="status != 'confirm'"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,confirm,done"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

    <button name="action_view_students"
            type="object"
            class="oe_stat_button"
            icon="fa-users">

        <field name="student_count" widget="statinfo" string="Students"/>

    </button>

</div>

                    <group col="2">

                        <!-- LEFT -->
                        <group string="Teacher Details">
                            <field name="image" widget="image"/>
                            <field name="name"/>
                            <field name="age"/>
                            <field name="dob"/>
                            <field name="gender" widget="radio"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>

                        <!-- RIGHT -->
                        <group string="Professional Details">
                            <field name="subject"/>
                            <field name="salary"/>
                        </group>

                    </group>

                    <!-- NOTEBOOK -->
                    <notebook>

                        <page string="Students">
                            <field name="student_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="fees"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>

                </sheet>

                <!-- CHATTER -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>

            </form>

        </field>
    </record>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_teacher_list" model="ir.ui.view">
        <field name="name">teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="subject"/>
                <field name="salary"/>
                <field name="status"/>
            </list>

        </field>
    </record>

    <!-- ================= KANBAN VIEW ================= -->
    <record id="view_teacher_kanban" model="ir.ui.view">
        <field name="name">teacher.kanban</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">

            <kanban>
                <field name="name"/>
                <field name="image"/>
                <field name="subject"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_card">

                            <div>
                                <img t-att-src="'/web/image/school.teacher/' + record.id.raw_value + '/image'"
                                     style="width:100px;height:100px;"
                                     alt="Teacher Image"/>
                            </div>

                            <div>
                                <strong><field name="name"/></strong>
                                <div><field name="subject"/></div>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>

        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- ================= MENU ================= -->
<menuitem id="menu_teacher"
          name="Teachers"
          parent="menu_school_root"
          action="action_teacher"
          sequence="2"/>

</odoo>