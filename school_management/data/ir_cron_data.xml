<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <record id="ir_cron_weekly_sale_report" model="ir.cron">
            <field name="name">Weekly Sale Order Report</field>

            <!-- sale.order model -->
            <field name="model_id" ref="sale.model_sale_order"/>

            <!-- Python Method -->
            <field name="state">code</field>
            <field name="code">model.generate_weekly_sale_report()</field>

            <!-- Run Every Week -->
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>

            <!-- Unlimited executions -->
            <field name="numeral">-1</field>

            <!-- Active -->
            <field name="active">True</field>

            <!-- Priority -->
            <field name="priority">5</field>

        </record>

    </data>

</odoo>